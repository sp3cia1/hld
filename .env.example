# Copy to .env (cp .env.example .env). Every variable the API's env schema expects is listed here.
# Native Postgres, no Docker. Create the user and both databases first (see README).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Dev database. Used by the API, `db:push`, `db:seed`, `db:reset` and `data:load`.
DATABASE_URL=postgresql://bh:bh@localhost:5432/hld

# Separate database for tests. When NODE_ENV=test the app and Prisma use this one instead of DATABASE_URL,
# so a test run can never touch dev data.
TEST_DATABASE_URL=postgresql://bh:bh@localhost:5432/hld_test
